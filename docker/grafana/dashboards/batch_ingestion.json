      "options": {
        "mode": "html",
        "content": "<div style=\"display:flex;justify-content:space-between;align-items:center;padding:8px 16px;border-left:4px solid #3274D9;\"><div><div style=\"font-size:16px;font-weight:600;\">Batch Ingestion Operations</div><div style=\"font-size:12px;color:#8E8E93;\"><b>Decision:</b> Are all 7 source files loading completely and on time? &nbsp;|&nbsp; <b>Source:</b> ops.batch_ingestion_log &nbsp;|&nbsp; <b>Success rate</b> = successful batches / attempted batches</div></div><div style=\"display:flex;gap:6px;\"><a href=\"/d/bi-channel-margin/channel-revenue-and-margin\" style=\"background:#22262E;color:#B3BAC5;padding:4px 10px;border-radius:4px;font-size:11px;text-decoration:none;border:1px solid #3A3F4B;\">Channel Margin</a><a href=\"/d/bi-hospital-forecast/hospital-forecast-vs-actual\" style=\"background:#22262E;color:#B3BAC5;padding:4px 10px;border-radius:4px;font-size:11px;text-decoration:none;border:1px solid #3A3F4B;\">Hospital Demand</a><a href=\"/d/bi-fast-slow/fast-vs-slow-movers\" style=\"background:#22262E;color:#B3BAC5;padding:4px 10px;border-radius:4px;font-size:11px;text-decoration:none;border:1px solid #3A3F4B;\">Fast / Slow</a><a href=\"/d/batch-ingestion/batch-ingestion-operations\" style=\"background:#22262E;color:#B3BAC5;padding:4px 10px;border-radius:4px;font-size:11px;text-decoration:none;border:1px solid #3A3F4B;\">Batch</a><a href=\"/d/streaming-ingestion/streaming-ingestion-operations\" style=\"background:#22262E;color:#B3BAC5;padding:4px 10px;border-radius:4px;font-size:11px;text-decoration:none;border:1px solid #3A3F4B;\">Streaming</a><a href=\"/d/storage-staging/storage-and-staging-health\" style=\"background:#22262E;color:#B3BAC5;padding:4px 10px;border-radius:4px;font-size:11px;text-decoration:none;border:1px solid #3A3F4B;\">Storage</a><a href=\"/d/query-performance/analytical-query-performance\" style=\"background:#22262E;color:#B3BAC5;padding:4px 10px;border-radius:4px;font-size:11px;text-decoration:none;border:1px solid #3A3F4B;\">Query</a></div></div>"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Batch success rate",
      "description": "Successful batch runs / total attempted runs x 100.",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 3
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "No batches logged yet. Trigger dag_02_ingestion",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#E02F44",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 90
              },
              {
                "color": "#73BF69",
                "value": 99
              }
            ]
          },
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(100.0 * COUNT(*) FILTER (WHERE status = 'SUCCESS') / NULLIF(COUNT(*), 0), 1)::float AS \"Success rate\" FROM ops.batch_ingestion_log",
          "refId": "A"
        }
      ]
    },

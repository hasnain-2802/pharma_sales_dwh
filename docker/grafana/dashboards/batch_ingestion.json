    {
      "id": 6,
      "type": "bargauge",
      "title": "Load duration by source file (s)",
      "description": "Largest single load per source file, in seconds. All 7 sources shown; the longest bar is the bottleneck.",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "mappings": [],
          "min": 0,
          "unit": "s",
          "decimals": 2,
          "noValue": "No batches logged yet. Trigger dag_02_ingestion",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#5794F2",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "namePlacement": "left",
        "showUnfilled": true,
        "valueMode": "color",
        "minVizHeight": 10,
        "minVizWidth": 0,
        "maxVizHeight": 300,
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH p(pfx) AS (VALUES ('01'),('02'),('03'),('04'),('05'),('06'),('07')), l AS (SELECT LEFT(source_name,2) AS pfx, MIN(source_name) AS source_name, MAX(duration_sec) AS v FROM ops.batch_ingestion_log WHERE status='SUCCESS' GROUP BY 1) SELECT COALESCE(l.source_name, p.pfx || ' (not loaded)') AS \"Source file\", COALESCE(l.v,0)::float AS \"Load duration (s)\" FROM p LEFT JOIN l ON l.pfx = p.pfx ORDER BY 2 DESC",
          "refId": "A"
        }
      ]
    },

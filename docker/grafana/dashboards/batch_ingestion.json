          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH p(pfx) AS (VALUES ('01'),('02'),('03'),('04'),('05'),('06'),('07')), l AS (SELECT LEFT(source_name,2) AS pfx, MIN(source_name) AS source_name, SUM(rows_loaded) AS v FROM ops.batch_ingestion_log WHERE status='SUCCESS' GROUP BY 1) SELECT COALESCE(l.source_name, p.pfx || ' (not loaded)') AS \"Source file\", COALESCE(l.v,0)::float AS \"Rows loaded\" FROM p LEFT JOIN l ON l.pfx = p.pfx ORDER BY 2 DESC",
          "refId": "A"
        }

          "rawSql": "SELECT ROUND(100.0 * COALESCE(SUM(rows_rejected),0) / NULLIF(SUM(rows_read),0), 2)::float AS \"Rejected %\" FROM ops.batch_ingestion_log",
          "refId": "A"
        }

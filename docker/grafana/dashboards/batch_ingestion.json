            "uid": "Staging-Postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT log_id AS \"ID\", source_name AS \"Source\", start_ts AS \"Start\", duration_sec AS \"Duration (s)\", rows_read AS \"Read\", rows_loaded AS \"Loaded\", rows_rejected AS \"Rejected\", status AS \"Status\" FROM ops.batch_ingestion_log ORDER BY log_id DESC LIMIT 25",

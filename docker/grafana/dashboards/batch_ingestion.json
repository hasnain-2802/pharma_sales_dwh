    {
      "id": 5,
      "type": "stat",
      "title": "On-Time %",
      "description": "Percentage of batch loads completing within target processing thresholds (< 60s)",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT round(100.0 * count(CASE WHEN duration_sec < 60.0 AND status = 'SUCCESS' THEN 1 END) / nullif(count(*), 0), 1) AS \"On-Time %\" FROM ops.batch_ingestion_log",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#E02F44",
                "value": null

{
  "id": null,
  "uid": "batch-ingestion",
  "title": "Batch Ingestion Metrics",
  "description": "Monitoring dashboard for batch ingestion pipeline metrics",
  "tags": ["pharma", "ingestion", "batch"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "barchart",
      "title": "Load Duration by Source",
      "description": "Average ingestion duration per source (seconds)",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT source_name, avg(duration_sec) as avg_duration FROM ops.batch_ingestion_log WHERE status='SUCCESS' GROUP BY source_name ORDER BY avg_duration DESC",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 15 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "showValue": "always",
        "stacking": "none",
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" },
        "xTickLabelRotation": 0
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Rows Processed",
      "description": "Sum of all rows successfully loaded",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT sum(rows_loaded) as total_rows FROM ops.batch_ingestion_log WHERE status='SUCCESS'",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Batch Success Rate %",
      "description": "Percentage of batches completed successfully",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE status='SUCCESS') / count(*), 2) as success_rate FROM ops.batch_ingestion_log",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 95 }
            ]
          },
          "min": 0,
          "max": 100,
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Recent Batch Loads",
      "description": "Last 20 batch ingestion records",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT file_name, source_name, start_ts, duration_sec, rows_loaded, rows_rejected, status FROM ops.batch_ingestion_log ORDER BY start_ts DESC LIMIT 20",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "SUCCESS": { "color": "green", "text": "SUCCESS" }, "FAILED": { "color": "red", "text": "FAILED" } } }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false }
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 5 }
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "Rows Loaded per Source",
      "description": "Total rows loaded and rejected by source",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT source_name, sum(rows_loaded) as total_loaded, sum(rows_rejected) as total_rejected FROM ops.batch_ingestion_log GROUP BY source_name ORDER BY total_loaded DESC",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "total_loaded" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "total_rejected" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "orientation": "vertical",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "showValue": "auto",
        "stacking": "normal",
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" },
        "xTickLabelRotation": -45
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Ingestion Over Time",
      "description": "Rows loaded over time by source",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT start_ts as time, rows_loaded, source_name FROM ops.batch_ingestion_log WHERE status='SUCCESS' ORDER BY start_ts",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "lineWidth": 2,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "scaleDistribution": { "type": "linear" }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 15 }
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "liveNow": false
}

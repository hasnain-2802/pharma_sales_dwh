    {
      "id": 10,
      "type": "bargauge",
      "title": "Load Duration by Source File: Pharmacy sales represents highest ingestion processing duration",
      "description": "Horizontal bar chart showing average load duration in seconds per source file. Starts strictly at zero baseline.",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT source_name AS \"Source File\", round(avg(duration_sec), 2) AS \"Average Duration (Seconds)\" FROM ops.batch_ingestion_log WHERE status = 'SUCCESS' GROUP BY source_name ORDER BY \"Average Duration (Seconds)\" DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Average Duration (Seconds)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#3274D9",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10,
        "valueMode": "color"

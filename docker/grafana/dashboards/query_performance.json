    {
      "id": 2,
      "type": "stat",
      "title": "Total Executions",
      "description": "Total analytical benchmark queries executed and monitored",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS \"Total Runs\" FROM ops.query_log",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 28
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Mean Latency",
      "description": "Mean execution duration across all successful analytical queries",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT round(avg(duration_ms), 1) AS \"Mean (ms)\" FROM ops.query_log WHERE status = 'SUCCESS'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "fixed",
            "fixedColor": "#73BF69"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 28
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 4
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "P95 Latency",
      "description": "95th percentile query execution duration ensuring analytical SLAs",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT round(percentile_cont(0.95) within group (order by duration_ms)::numeric, 1) AS \"P95 (ms)\" FROM ops.query_log WHERE status = 'SUCCESS'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#73BF69",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 500
              },
              {
                "color": "#E02F44",
                "value": 1500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 28
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,

{
  "id": null,
  "uid": "query-performance",
  "title": "Analytical Query Performance",
  "description": "Dashboard for monitoring analytical query performance and optimization",
  "tags": ["pharma", "query", "performance"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "barchart",
      "title": "Avg Query Execution Time (ms)",
      "description": "Average execution time per query — base vs optimized variants",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT query_name, variant, avg_ms FROM ops.v_query_summary ORDER BY query_name, variant",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "showValue": "auto",
        "stacking": "none",
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" },
        "xTickLabelRotation": -45
      },
      "transformations": [
        {
          "id": "prepareTimeSeries",
          "options": {
            "format": "multi"
          }
        }
      ],
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Queries Executed",
      "description": "Total number of queries recorded in the query log",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) as total FROM ops.query_log",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Query Error Rate %",
      "description": "Percentage of queries that failed",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT round(100.0 * count(*) FILTER (WHERE status='FAILED') / count(*), 2) as error_rate FROM ops.query_log",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          },
          "min": 0,
          "max": 100,
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto"
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Query Performance Summary",
      "description": "Detailed query performance summary with base and optimized variants",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT * FROM ops.v_query_summary ORDER BY query_name, variant",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "error_rate_pct" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 5 },
                    { "color": "red", "value": 20 }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text" }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": { "show": false }
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 5 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Daily Query Count",
      "description": "Number of queries executed per day (total and failed)",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT day as time, query_count, failed FROM ops.v_query_daily ORDER BY day",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false,
            "lineWidth": 2,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "scaleDistribution": { "type": "linear" }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "failed" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Base vs Optimized Speedup",
      "description": "Speedup ratio of optimized queries compared to base",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT b.query_name, b.avg_ms as base_ms, o.avg_ms as opt_ms, round(b.avg_ms / nullif(o.avg_ms, 0), 2) as speedup FROM ops.v_query_summary b JOIN ops.v_query_summary o ON b.query_name = o.query_name WHERE b.variant = 'base' AND o.variant = 'opt'",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "base_ms" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } },
              { "id": "unit", "value": "ms" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "opt_ms" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } },
              { "id": "unit", "value": "ms" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "speedup" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } },
              { "id": "unit", "value": "x" }
            ]
          }
        ]
      },
      "options": {
        "orientation": "vertical",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "showValue": "auto",
        "stacking": "none",
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" },
        "xTickLabelRotation": -45
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 15 }
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "liveNow": false
}

    {
      "id": 10,
      "type": "barchart",
      "title": "Query Execution Duration: Base Scans vs Optimized Variants (ms)",
      "description": "Comparative benchmark showing execution latency in milliseconds before and after indexing optimizations",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT b.query_name AS \"Query Benchmark\", b.avg_ms AS \"Base Scan (ms)\", o.avg_ms AS \"Optimized (ms)\" FROM ops.v_query_summary b JOIN ops.v_query_summary o ON b.query_name = o.query_name WHERE b.variant = 'base' AND o.variant = 'opt' ORDER BY b.avg_ms DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Base Scan (ms)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#EAB839",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Optimized (ms)"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#73BF69",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "barWidth": 0.65,
        "showValue": "always",
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "xTickLabelRotation": 0,
        "xField": "Query Benchmark"
      },
      "gridPos": {
        "h": 9,
        "w": 13,
        "x": 0,
        "y": 9
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Optimization Speedup Multiplier by Query Workload",
      "description": "Ratio of base execution duration divided by optimized duration. Strictly starts at zero baseline.",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT b.query_name AS \"Query Workload\", round(b.avg_ms / nullif(o.avg_ms, 0), 2) AS \"Speedup Factor (x)\" FROM ops.v_query_summary b JOIN ops.v_query_summary o ON b.query_name = o.query_name WHERE b.variant = 'base' AND o.variant = 'opt' ORDER BY \"Speedup Factor (x)\" DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10,
        "valueMode": "color"
      },
      "gridPos": {
        "h": 9,
        "w": 11,
        "x": 13,
        "y": 9
      }
    },

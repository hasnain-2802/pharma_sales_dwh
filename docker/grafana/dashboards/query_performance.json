    {
      "id": 20,
      "type": "timeseries",
      "title": "Analytical Query Volume & Error Profile Over Time",
      "description": "Daily executions tracked chronologically to evaluate system workload trends",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT day::timestamp with time zone AS time, query_count AS \"Total Invocations\", failed AS \"Failed Queries\" FROM ops.v_query_daily ORDER BY day",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 12,
            "axisSoftMin": 0,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "gradientMode": "opacity",
            "showPoints": "auto",
            "pointSize": 4
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Total Invocations"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#5794F2",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Failed Queries"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#E02F44",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 0,
        "y": 19
      }
    },
    {
      "id": 21,
      "type": "table",
      "title": "Detailed Query Benchmark Audit Matrix",
      "description": "Complete breakdown of benchmark runs, mean and minimum durations, and error rates",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT query_name AS \"Benchmark Query\", variant AS \"Optimization Tier\", runs AS \"Runs Monitored\", avg_ms AS \"Avg Duration (ms)\", min_ms AS \"Min Duration (ms)\", error_rate_pct AS \"Error Rate %\", CASE WHEN avg_ms < 100 THEN 'Optimal' WHEN avg_ms < 500 THEN 'Acceptable' ELSE 'Tuning Required' END AS \"Performance Health\" FROM ops.v_query_summary ORDER BY query_name, variant",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#73BF69",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Performance Health"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Optimal": {
                        "color": "#73BF69",
                        "text": "Optimal"
                      },
                      "Acceptable": {
                        "color": "#EAB839",
                        "text": "Acceptable"
                      },
                      "Tuning Required": {
                        "color": "#E02F44",
                        "text": "Tuning Required"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "gridPos": {

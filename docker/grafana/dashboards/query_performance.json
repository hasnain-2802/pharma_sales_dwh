    {
      "id": 6,
      "type": "stat",
      "title": "Mean Speedup",
      "description": "Average speedup factor achieved across optimized query variants",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT round(avg(b.avg_ms / nullif(o.avg_ms, 0)), 1) AS \"Speedup (x)\" FROM ops.v_query_summary b JOIN ops.v_query_summary o ON b.query_name = o.query_name WHERE b.variant = 'base' AND o.variant = 'opt'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#20B2AA"
          },
          "custom": {},
          "unit": "none",
          "decimals": 1,
          "overrides": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 12,
          "valueSize": 28
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 4
      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Error Rate",
      "description": "Percentage of analytical queries resulting in timeout or execution error",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT round(100.0 * count(CASE WHEN status = 'FAILED' THEN 1 END) / nullif(count(*), 0), 2) AS \"Error Rate %\" FROM ops.query_log",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#73BF69",
                "value": null
              },
              {
                "color": "#E02F44",
                "value": 1.0
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]

    {
      "id": 30,
      "type": "table",
      "title": "Priority Action Queue",
      "description": "Hospitals \u00d7 Therapeutic Classes ranked by worst service level. Red = Critical (< 90%), Amber = At Risk (90\u201395%), Green = On Target (\u2265 95%)",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT s.hosp_name AS \"Hospital\", CASE WHEN s.therapeutic_class IS NULL OR s.therapeutic_class = '' THEN 'Unclassified' ELSE s.therapeutic_class END AS \"Therapeutic Class\", round(s.avg_service_level::numeric, 1) AS \"Service Level %\", CASE WHEN s.avg_service_level < 90 THEN '\ud83d\udd34 Critical' WHEN s.avg_service_level < 95 THEN '\ud83d\udfe1 At Risk' ELSE '\ud83d\udfe2 On Target' END AS \"Status\", s.unfulfilled AS \"Unfulfilled Packs\", s.stockout_days AS \"Stockout Days\", CASE WHEN s.avg_service_level < 85 THEN 'Dispatch Emergency Re-supply' WHEN s.avg_service_level < 90 THEN 'Re-allocate Regional Buffer' WHEN s.avg_service_level < 95 THEN 'Review Lead Time & Reorder' ELSE 'Maintain Standard Flow' END AS \"Recommended Action\" FROM bi.service_level_detail s JOIN bi.hospital_demand h ON h.hosp_name = s.hosp_name WHERE ('$region' = 'ALL' OR h.region = '$region') AND ('$hospital' = 'ALL' OR s.hosp_name = '$hospital') ORDER BY s.avg_service_level ASC LIMIT 20",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",

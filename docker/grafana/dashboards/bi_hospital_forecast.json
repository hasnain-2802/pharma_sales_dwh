        {
          "rawSql": "SELECT CASE WHEN therapeutic_class IS NULL OR therapeutic_class = '' THEN 'Unclassified' ELSE therapeutic_class END AS \"Therapeutic Class\", unfulfilled AS \"Unfulfilled Packs\" FROM bi.unfulfilled_by_class ORDER BY unfulfilled DESC LIMIT 10",

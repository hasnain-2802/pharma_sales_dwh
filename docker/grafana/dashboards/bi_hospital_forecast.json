    {
      "id": 10,
      "type": "barchart",
      "title": "Top 10 Hospitals by Unfulfilled Packs",
      "description": "Hospitals with the highest unfulfilled demand. Units: packs only.",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT hosp_name AS \"Hospital\", total_unfulfilled AS \"Unfulfilled Packs\", round(avg_service_level::numeric, 1) AS \"Service Level %\" FROM bi.hospital_demand WHERE ('$region' = 'ALL' OR region = '$region') AND ('$hospital' = 'ALL' OR hosp_name = '$hospital') ORDER BY total_unfulfilled DESC LIMIT 10",
          "format": "table",
          "refId": "A"
        }

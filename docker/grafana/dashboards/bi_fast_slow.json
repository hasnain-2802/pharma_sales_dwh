    {
      "id": 20,
      "type": "table",
      "title": "Medicine 360\u00b0 View",
      "description": "Cross-fact medicine profile: commercial revenue, clinical demand, service level, and margin",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT CASE WHEN med_name IS NULL OR med_name = '' THEN 'Unknown' ELSE med_name END AS \"Medicine\", CASE WHEN disease_category IS NULL OR disease_category = '' THEN 'Unclassified' ELSE disease_category END AS \"Disease Category\", CASE WHEN therapeutic_class IS NULL OR therapeutic_class = '' THEN 'Unclassified' ELSE therapeutic_class END AS \"Therapeutic Class\", cold_chain_flag AS \"Cold Chain\", total_txns AS \"Transactions\", round(total_revenue::numeric, 0) AS \"Revenue ($)\", round(avg_margin_pct::numeric, 1) AS \"Margin %\", total_forecast AS \"Forecast Packs\", total_unfulfilled AS \"Unfulfilled\", round(avg_service_level::numeric, 1) AS \"Service Level %\", total_stockout_days AS \"Stockout Days\" FROM bi.medicine_360 WHERE total_txns > 0 AND ('$disease_category' = 'ALL' OR disease_category = '$disease_category') AND ('$therapeutic_class' = 'ALL' OR therapeutic_class = '$therapeutic_class') ORDER BY total_revenue DESC",
          "format": "table",
          "refId": "A"
        }
      ],

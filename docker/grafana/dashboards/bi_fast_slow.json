    {
      "id": 3,
      "type": "stat",
      "title": "Top-3 Revenue Share",
      "description": "Revenue share of the top-3 medicines by quantity sold",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "WITH top3 AS (SELECT total_revenue FROM bi.medicine_360 WHERE total_revenue IS NOT NULL ORDER BY total_revenue DESC LIMIT 3) SELECT round((100.0 * sum(total_revenue) / nullif((SELECT sum(total_revenue) FROM bi.medicine_360), 0))::numeric, 1) AS \"value\" FROM top3",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "fixed",
            "fixedColor": "#73BF69"

      },
      "options": {
        "mode": "html",
        "content": "\n<div style=\"display: flex; justify-content: space-between; align-items: center; background: linear-gradient(90deg, #181B1F 0%, #1e2228 100%); padding: 10px 18px; border-radius: 6px; border-left: 4px solid #3274D9; margin-bottom: 4px; box-shadow: 0 2px 6px rgba(0,0,0,0.3);\">\n  <div>\n    <div style=\"font-size: 16px; font-weight: 600; color: #FFFFFF; letter-spacing: 0.3px;\">PostgreSQL Staging Health & Storage Footprint</div>\n    <div style=\"font-size: 12px; color: #8E8E93; margin-top: 2px;\"><b>Primary Decision:</b> Track physical disk allocation, table row counts, and date coverage integrity &nbsp;|&nbsp; <b>Audience:</b> Database Administrators & SRE &nbsp;|&nbsp; <b>Coverage:</b> 2023\u20132026 &nbsp;|&nbsp; <b>Auto-Refresh:</b> 1m</div>\n  </div>\n  <div style=\"display: flex; gap: 8px;\">\n    <a href=\"/d/bi-channel-margin/channel-revenue-and-margin\" style=\"background: #22262E; color: #61AFFE; padding: 4px 10px; border-radius: 4px; font-size: 11px; text-decoration: none; font-weight: 500; border: 1px solid #3274D9;\">\ud83d\udcca Channel Margin</a>\n    <a href=\"/d/bi-hospital-forecast/hospital-forecast-vs-actual\" style=\"background: #22262E; color: #49DA9A; padding: 4px 10px; border-radius: 4px; font-size: 11px; text-decoration: none; font-weight: 500; border: 1px solid #299C46;\">\ud83c\udfe5 Hospital Demand</a>\n    <a href=\"/d/bi-fast-slow/fast-vs-slow-movers\" style=\"background: #22262E; color: #FADE2A; padding: 4px 10px; border-radius: 4px; font-size: 11px; text-decoration: none; font-weight: 500; border: 1px solid #EAB839;\">\u26a1 Fast / Slow</a>\n    <a href=\"/d/batch-ingestion/batch-ingestion-operations\" style=\"background: #22262E; color: #B3BAC5; padding: 4px 10px; border-radius: 4px; font-size: 11px; text-decoration: none; font-weight: 500; border: 1px solid #3A3F4B;\">\ud83d\udce6 Batch DE</a>\n    <a href=\"/d/streaming-ingestion/streaming-ingestion-operations\" style=\"background: #22262E; color: #B3BAC5; padding: 4px 10px; border-radius: 4px; font-size: 11px; text-decoration: none; font-weight: 500; border: 1px solid #3A3F4B;\">\ud83d\udce1 Streaming DE</a>\n    <a href=\"/d/storage-staging/storage-and-staging-health\" style=\"background: #22262E; color: #B3BAC5; padding: 4px 10px; border-radius: 4px; font-size: 11px; text-decoration: none; font-weight: 500; border: 1px solid #3A3F4B;\">\ud83d\uddc4\ufe0f Storage DE</a>\n    <a href=\"/d/query-performance/analytical-query-performance\" style=\"background: #22262E; color: #B3BAC5; padding: 4px 10px; border-radius: 4px; font-size: 11px; text-decoration: none; font-weight: 500; border: 1px solid #3A3F4B;\">\u26a1 Query DE</a>\n  </div>\n</div>\n"
      },
      "transparent": true
    },
    {
      "id": 100,
      "type": "row",
      "title": "Executive Staging Metrics & Footprint",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Staged Records",
      "description": "Total cumulative record volume across all enterprise staging tables",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT sum(cnt) AS \"Total Records\" FROM (SELECT count(*) AS cnt FROM stg.master_data UNION ALL SELECT count(*) FROM stg.manufacturing_data UNION ALL SELECT count(*) FROM stg.manufacturer_delivery_data UNION ALL SELECT count(*) FROM stg.warehouse_data UNION ALL SELECT count(*) FROM stg.pharmacy_sales_data UNION ALL SELECT count(*) FROM stg.hospital_demand_data UNION ALL SELECT count(*) FROM stg.iot_streaming_data) t",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 28
        }
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 4
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Storage Footprint",
      "description": "Total physical disk footprint occupied by stg schema tables and indexes",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT round(sum(pg_total_relation_size('stg.' || tablename)) / (1024.0 * 1024.0), 1) AS \"Footprint (MB)\" FROM pg_tables WHERE schemaname = 'stg'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "color": {
            "mode": "fixed",
            "fixedColor": "#73BF69"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 28
        }
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 5,
        "y": 4
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active Tables",
      "description": "Total active enterprise relational tables populated in the stg schema",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) AS \"Staging Tables\" FROM pg_tables WHERE schemaname = 'stg'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#3274D9"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 28
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 10,
        "y": 4
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Date Coverage Span",
      "description": "Temporal date boundaries represented within historical pharmacy sales records",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT (max(salesdate::date) - min(salesdate::date)) AS \"Coverage (Days)\", concat(min(salesdate::date), ' to ', max(salesdate::date)) AS \"Span\" FROM stg.pharmacy_sales_data",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#20B2AA"
          },
          "unit": "d",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Coverage \\(Days\\)$/"
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 12,
          "valueSize": 26
        }
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 4
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Data Freshness",
      "description": "Timestamp of most recent batch committed into the staging repository",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT round(extract(epoch from (now() - max(end_ts)))) AS \"Lag (Seconds)\", to_char(max(end_ts), 'YYYY-MM-DD HH24:MI:SS') AS \"Last Run\" FROM ops.batch_ingestion_log",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#EAB839"
          },
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Lag \\(Seconds\\)$/"
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "text": {
          "titleSize": 12,
          "valueSize": 26
        }
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 4
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Source Volume & Physical Footprint Distribution",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 8
      }
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Staged Record Volume by Source Table: Pharmacy sales and IoT telemetry constitute 85% of volume",
      "description": "Sorted horizontal bar chart displaying total committed rows per table. Strictly starts at zero baseline.",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT 'Pharmacy Sales' as \"Source Table\", count(*) as \"Record Count\" FROM stg.pharmacy_sales_data UNION ALL SELECT 'IoT Streaming', count(*) FROM stg.iot_streaming_data UNION ALL SELECT 'Warehouse Inventory', count(*) FROM stg.warehouse_data UNION ALL SELECT 'Hospital Demand', count(*) FROM stg.hospital_demand_data UNION ALL SELECT 'Manufacturer Delivery', count(*) FROM stg.manufacturer_delivery_data UNION ALL SELECT 'Manufacturing Orders', count(*) FROM stg.manufacturing_data UNION ALL SELECT 'Product Master', count(*) FROM stg.master_data ORDER BY \"Record Count\" DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10,
        "valueMode": "color"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 9
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Storage Footprint by Table (MB): Sales table leads footprint at ~110MB total on-disk allocation",
      "description": "Total relation footprint (table data + indexes) in megabytes per staging entity",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT 'Pharmacy Sales' as \"Source Table\", round(pg_total_relation_size('stg.pharmacy_sales_data') / (1024.0 * 1024.0), 2) as \"Footprint (MB)\" UNION ALL SELECT 'IoT Streaming', round(pg_total_relation_size('stg.iot_streaming_data') / (1024.0 * 1024.0), 2) UNION ALL SELECT 'Warehouse Inventory', round(pg_total_relation_size('stg.warehouse_data') / (1024.0 * 1024.0), 2) UNION ALL SELECT 'Hospital Demand', round(pg_total_relation_size('stg.hospital_demand_data') / (1024.0 * 1024.0), 2) UNION ALL SELECT 'Manufacturer Delivery', round(pg_total_relation_size('stg.manufacturer_delivery_data') / (1024.0 * 1024.0), 2) UNION ALL SELECT 'Manufacturing Orders', round(pg_total_relation_size('stg.manufacturing_data') / (1024.0 * 1024.0), 2) UNION ALL SELECT 'Product Master', round(pg_total_relation_size('stg.master_data') / (1024.0 * 1024.0), 2) ORDER BY \"Footprint (MB)\" DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {},
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "minVizWidth": 0,
        "minVizHeight": 10,
        "valueMode": "color"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 9
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Ingestion Quality & Staging Entity Audit",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      }
    },
    {
      "id": 20,
      "type": "barchart",
      "title": "Cumulative Rows Loaded vs Quarantined by Ingestion Source",
      "description": "Validation compliance: Compares committed records against rejected quarantine packets per source feed",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT source_name as \"Source Stream\", sum(rows_loaded) as \"Loaded\", sum(rows_rejected) as \"Quarantined\" FROM ops.batch_ingestion_log GROUP BY source_name ORDER BY \"Loaded\" DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {}
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Loaded"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#73BF69",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Quarantined"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#E02F44",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "barWidth": 0.6,
        "showValue": "always",
        "stacking": "none",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        },
        "xTickLabelRotation": 0,
        "xField": "Source Stream"
      },
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 0,
        "y": 19
      }
    },
    {
      "id": 21,
      "type": "table",
      "title": "Staging Schema Inventory & Entity Storage Matrix",
      "description": "Comprehensive physical storage parameters, table size, index size, and record tallies",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT tablename AS \"Table Entity\", CASE tablename WHEN 'pharmacy_sales_data' THEN (SELECT count(*) FROM stg.pharmacy_sales_data) WHEN 'iot_streaming_data' THEN (SELECT count(*) FROM stg.iot_streaming_data) WHEN 'warehouse_data' THEN (SELECT count(*) FROM stg.warehouse_data) WHEN 'hospital_demand_data' THEN (SELECT count(*) FROM stg.hospital_demand_data) WHEN 'manufacturer_delivery_data' THEN (SELECT count(*) FROM stg.manufacturer_delivery_data) WHEN 'manufacturing_data' THEN (SELECT count(*) FROM stg.manufacturing_data) WHEN 'master_data' THEN (SELECT count(*) FROM stg.master_data) ELSE 0 END AS \"Total Rows\", pg_size_pretty(pg_total_relation_size('stg.' || tablename)) AS \"Disk Allocation\", pg_size_pretty(pg_indexes_size('stg.' || tablename)) AS \"Index Size\", 'Active Verified' AS \"Integrity Status\" FROM pg_tables WHERE schemaname = 'stg' ORDER BY pg_total_relation_size('stg.' || tablename) DESC",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#73BF69",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Integrity Status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "Total Rows"
          ]
        }
      },
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 10,
        "y": 19
      }
    }

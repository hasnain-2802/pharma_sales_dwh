          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH p(pfx) AS (VALUES ('01'),('02'),('03'),('04'),('05'),('06'),('07')),\r\nl AS (\r\n  SELECT LEFT(source_name, 2) AS pfx, MIN(source_name) AS source_name,\r\n         SUM(rows_loaded) AS n\r\n  FROM ops.batch_ingestion_log\r\n  WHERE status = 'SUCCESS'\r\n  GROUP BY 1\r\n)\r\nSELECT COALESCE(l.source_name, p.pfx || ' (not loaded)') AS \"Source\",\r\n       COALESCE(l.n, 0)::float AS \"Rows\"\r\nFROM p LEFT JOIN l ON l.pfx = p.pfx\r\nORDER BY 2 DESC",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"

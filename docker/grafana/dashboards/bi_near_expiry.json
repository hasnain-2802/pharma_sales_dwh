{
  "uid": "bi-near-expiry",
  "title": "Near-Expiry Risk Matrix",
  "description": "Monitor capital at risk from medicines nearing expiration within 0-30, 31-60, and 61-90 day windows",
  "tags": [
    "phase2",
    "inventory",
    "near-expiry",
    "risk",
    "bi"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "html",
        "content": "\n<div style=\"display: flex; justify-content: space-between; align-items: center; background: linear-gradient(90deg, #181B1F 0%, #1e2228 100%); padding: 10px 18px; border-radius: 6px; border-left: 4px solid #3274D9; margin-bottom: 4px; box-shadow: 0 2px 6px rgba(0,0,0,0.3);\">\n  <div>\n    <div style=\"font-size: 16px; font-weight: 600; color: #FFFFFF; letter-spacing: 0.3px;\">Near-Expiry Risk Matrix & Capital Exposure</div>\n    <div style=\"font-size: 12px; color: #8E8E93; margin-top: 2px;\"><b>Primary Decision:</b> Prioritize inventory liquidation or inter-hub transfers before expiration write-offs occur &nbsp;|&nbsp; <b>Audience:</b> Cold Chain Quality Assurance & Financial Controller &nbsp;|&nbsp; <b>Auto-Refresh:</b> 10s</div>\n  </div>\n  <div style=\"display: flex; gap: 8px;\">\n    <a href=\"/d/bi-stockout-overstock/stockout-vs-overstock\" style=\"background: #22262E; color: #61AFFE; padding: 4px 10px; border-radius: 4px; font-size: 11px; text-decoration: none; font-weight: 500; border: 1px solid #3274D9;\">\ud83d\udce6 Stockout / Overstock</a>\n    <a href=\"/d/bi-near-expiry/near-expiry-risk-matrix\" style=\"background: #22262E; color: #FADE2A; padding: 4px 10px; border-radius: 4px; font-size: 11px; text-decoration: none; font-weight: 500; border: 1px solid #EAB839;\">\u26a0\ufe0f Expiry Matrix</a>\n    <a href=\"/d/bi-fefo-compliance/fefo-compliance-score\" style=\"background: #22262E; color: #49DA9A; padding: 4px 10px; border-radius: 4px; font-size: 11px; text-decoration: none; font-weight: 500; border: 1px solid #299C46;\">\ud83c\udfaf FEFO Score</a>\n    <a href=\"/d/bi-channel-margin/channel-revenue-and-margin\" style=\"background: #22262E; color: #B3BAC5; padding: 4px 10px; border-radius: 4px; font-size: 11px; text-decoration: none; font-weight: 500; border: 1px solid #3A3F4B;\">\ud83d\udcca Phase 1 BI</a>\n    <a href=\"/d/storage-staging/storage-and-staging-health\" style=\"background: #22262E; color: #B3BAC5; padding: 4px 10px; border-radius: 4px; font-size: 11px; text-decoration: none; font-weight: 500; border: 1px solid #3A3F4B;\">\ud83d\uddc4\ufe0f Storage DE</a>\n  </div>\n</div>\n"
      },
      "transparent": true
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Capital at Expiry Risk",
      "description": "Total wholesale value of stock expiring within <= 90 days",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 2
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT coalesce(sum(at_risk_usd), 0) AS \"At Risk USD\" FROM mart.near_expiry",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 50000
              },
              {
                "color": "#F2495C",
                "value": 150000
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Near-Expiry Lots Affected",
      "description": "Count of distinct warehouse lots expiring within <= 90 days",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 2
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT coalesce(sum(lots), 0) AS \"Total Lots\" FROM mart.near_expiry",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 10
              },
              {
                "color": "#F2495C",
                "value": 30
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Critical Stock Expiring (0-30 Days)",
      "description": "Immediate write-off danger if not expedited or returned",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 2
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT coalesce(sum(at_risk_usd), 0) AS \"0-30 Day Risk\" FROM mart.near_expiry WHERE bucket IN ('0-30', 'Expired')",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#F2495C",
                "value": 1
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Near-Expiry Breakdown Matrix by Warehouse & Urgency Bucket",
      "description": "Breakdown of lots, pack quantities, and monetary value at risk",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT wh_name AS \"Warehouse\", bucket AS \"Expiry Window\", lots AS \"Lots\", qty AS \"Quantity (Packs)\", at_risk_usd AS \"Value at Risk (USD)\" FROM mart.near_expiry ORDER BY CASE bucket WHEN 'Expired' THEN 1 WHEN '0-30' THEN 2 WHEN '31-60' THEN 3 ELSE 4 END, at_risk_usd DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Value at Risk (USD)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Quantity (Packs)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      }
    },
    {
      "id": 99,
      "type": "timeseries",
      "title": "Pipeline Live Refresh Verification (mart.refresh_status)",
      "description": "Demonstrates real-time row count progression across Airflow refresh cycles",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT published_at AS time, table_name AS metric, row_count FROM mart.refresh_status ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "showPoints": "always",
            "pointSize": 6
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    }
  ]
}
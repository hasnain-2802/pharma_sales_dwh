    {
      "id": 30,
      "type": "table",
      "title": "Recent Sensor Observations & Thermal Audit Log",
      "description": "Real-time inspection of active IoT telemetry packets with temperature bounds and excursion tags",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT deviceid AS \"Device ID\", assettype AS \"Asset Type\", coalesce(nullif(warehouseid, ''), shipmentid) AS \"Location / Shipment\", round(nullif(temperaturec, '')::numeric, 1) AS \"Temperature (C)\", round(nullif(relativehumiditypct, '')::numeric, 1) AS \"Humidity (%)\", alertseverity AS \"Severity\", round(nullif(datalatencyseconds, '')::numeric, 1) AS \"Latency (s)\", readingquality AS \"Quality\", CASE WHEN alertseverity = 'Critical' THEN 'Quarantine Lot' WHEN alertseverity = 'Warning' THEN 'Inspect Refrigeration' ELSE 'Normal Operation' END AS \"Protocol Action\" FROM stg.iot_streaming_data ORDER BY _ingested_at DESC, sensorreadingid DESC LIMIT 20",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#73BF69",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Severity"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Normal": {
                        "color": "#73BF69",
                        "text": "Normal"
                      },
                      "Warning": {
                        "color": "#EAB839",
                        "text": "Warning"
                      },
                      "Critical": {
                        "color": "#E02F44",
                        "text": "Critical"
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Protocol Action"
            },
            "properties": [

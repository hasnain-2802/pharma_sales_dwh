    {
      "id": 10,
      "type": "timeseries",
      "title": "Real-Time Telemetry Throughput by Stream Channel",
      "description": "Multi-line time-series tracking telemetry ingestion volume per minute split across Warehouse and Transit Freight channels",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT date_trunc('minute', _ingested_at) AS time, count(*) FILTER (WHERE sourcestream LIKE '%warehouse%') AS \"Warehouse Environment\", count(*) FILTER (WHERE sourcestream LIKE '%shipment%') AS \"Transit Freight\", count(*) FILTER (WHERE sourcestream NOT LIKE '%warehouse%' AND sourcestream NOT LIKE '%shipment%') AS \"Direct Telemetry API\" FROM stg.iot_streaming_data GROUP BY 1 ORDER BY 1",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 12,
            "pointSize": 4,
            "showPoints": "auto",
            "lineWidth": 2,
            "axisSoftMin": 0,
            "gradientMode": "opacity"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Warehouse Environment"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#5794F2",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Transit Freight"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#20B2AA",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Direct Telemetry API"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "#73BF69",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }

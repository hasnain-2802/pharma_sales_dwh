        "orientation": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ROUND(SUM(events_in)::numeric / NULLIF(COUNT(*), 0), 1)::float AS \"Throughput (events/s)\" FROM  WHERE run_id = (SELECT run_id FROM ops.stream_ingestion_log ORDER BY batch_ts DESC LIMIT 1)",
          "refId": "A"
        }
      ]

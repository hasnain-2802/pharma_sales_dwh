{
  "id": null,
  "uid": "streaming-ingestion",
  "title": "Streaming Ingestion Metrics",
  "description": "Monitoring dashboard for IoT streaming ingestion pipeline",
  "tags": ["pharma", "ingestion", "streaming", "iot"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "IoT Records Ingested",
      "description": "Total records in IoT streaming staging table",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) as total_records FROM stg.iot_streaming_data",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Stream Throughput (records/batch)",
      "description": "Average rows loaded per batch for IoT streaming",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT avg(rows_loaded) as avg_throughput FROM ops.batch_ingestion_log WHERE source_name = '07_iot_streaming_data'",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 0 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Malformed/Rejected Records",
      "description": "Total rejected records for IoT streaming source",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT count(*) as rejected FROM stg.rejected_records WHERE source_name = '07_iot_streaming_data'",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 100 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "IoT Ingestion Duration Over Time",
      "description": "Duration of each IoT ingestion batch over time",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT start_ts as time, duration_sec FROM ops.batch_ingestion_log WHERE source_name = '07_iot_streaming_data' ORDER BY start_ts",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20,
            "pointSize": 5,
            "showPoints": "always",
            "spanNulls": false,
            "lineWidth": 2,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "scaleDistribution": { "type": "linear" }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 6 }
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "IoT Throughput per Batch (Records/Sec)",
      "description": "Records processed per second for each IoT batch",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT file_name, CASE WHEN duration_sec > 0 THEN round(rows_loaded::numeric / duration_sec, 2) ELSE 0 END as records_per_sec FROM ops.batch_ingestion_log WHERE source_name = '07_iot_streaming_data' AND status='SUCCESS' ORDER BY start_ts DESC LIMIT 10",
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "Staging-Postgres"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "barWidth": 0.7,
        "groupWidth": 0.7,
        "showValue": "always",
        "stacking": "none",
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" },
        "xTickLabelRotation": -45
      },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 6 }
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "time": { "from": "now-7d", "to": "now" },
  "timepicker": {},
  "liveNow": false
}

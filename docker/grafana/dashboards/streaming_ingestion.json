    {
      "id": 2,
      "type": "stat",
      "title": "Stream Rate",
      "description": "Mean sensor telemetry packets processed per second during active streaming",
      "datasource": {
        "type": "postgres",
        "uid": "Staging-Postgres"
      },
      "targets": [
        {
          "rawSql": "SELECT round(count(*)::numeric / nullif(extract(epoch from (max(_ingested_at) - min(_ingested_at))), 0), 1) AS \"Events/Sec\" FROM stg.iot_streaming_data WHERE _source_file = 'api_stream'",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "fixed",
            "fixedColor": "#5794F2"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "text": {
          "titleSize": 12,
          "valueSize": 28
        }
      },
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 0,
        "y": 4
